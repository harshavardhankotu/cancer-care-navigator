{
  "$schema": "https://opencode.ai/config.json",

  // Health-data repo: restrictive by default. Read/test/git-inspect allowed,
  // everything else asks, network fetch denied.
  "instructions": ["AGENTS.md", ".opencode/GUARDRAILS.md"],

  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      // broad default first...
      "*": "ask",
      // ...safe read/test commands allowed (narrow rules last)
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "python smoke_test.py*": "allow",
      "python -m pytest *": "allow",
      "..\\.venv\\Scripts\\python.exe smoke_test.py*": "allow",
      "..\\.venv\\Scripts\\python.exe -m pytest *": "allow",
      "npm run build*": "allow",
      "npm test*": "allow",
      // hard denies (never let an unattended run do these)
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  },

  "agent": {
    "loop-build": {
      "description": "Scoped loop agent: structural/PHI-free tasks only. See .opencode/GUARDRAILS.md.",
      "mode": "primary",
      "steps": 12,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "python smoke_test.py*": "allow",
          "python -m pytest *": "allow",
          "npm run build*": "allow",
          "npm test*": "allow",
          "git diff*": "allow",
          "git status*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
